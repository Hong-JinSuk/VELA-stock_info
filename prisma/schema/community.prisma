// 커뮤니티 — 게시판/후기 기능. 베이스(title/content + 보드 type)를 단일 구조로 두고
// 게시판별 설정은 CommunityBoard에 둔다. 향후 자유게시판/Q&A 등은 BoardType만 추가.
// ⚠️ timestamp는 KST 벽시계로 저장 — 앱에서 kstNow()(src/lib/kst.ts) 주입 (@default(now()) 미사용).

enum CommunityBoardType {
  REVIEW // 사용 후기 (별점)
}

// 별점 작성 권한(관리탭 selection). ALL = 로그인 사용자 누구나, ADMIN = 관리자만.
enum RatingWritePolicy {
  ALL
  ADMIN
}

model CommunityBoard {
  id                String             @id @default(uuid())
  key               String             @unique // 'reviews'
  title             String // '사용 후기'
  type              CommunityBoardType @default(REVIEW)
  enableRating      Boolean            @default(true)
  ratingWritePolicy RatingWritePolicy  @default(ADMIN)
  commentMaxDepth   Int                @default(2) // 1..3
  sortOrder         Int                @default(0)
  createdAt         DateTime // KST 주입
  updatedAt         DateTime // KST 주입

  posts CommunityPost[]
}

model CommunityPost {
  id      String  @id @default(uuid())
  boardId String
  userId  String
  title   String
  content String
  rating  Int? // 1..5, 보드 ratingWritePolicy에 따라 작성/수정

  createdAt DateTime // KST 주입
  updatedAt DateTime // KST 주입

  board    CommunityBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CommunityComment[]

  @@unique([boardId, userId]) // 1인 1후기
  @@index([boardId, createdAt(sort: Desc)])
}

model CommunityComment {
  id       String  @id @default(uuid())
  postId   String
  userId   String
  parentId String? // null = 최상위 댓글
  content  String
  depth    Int     @default(1) // 1..보드 commentMaxDepth

  createdAt DateTime // KST 주입
  updatedAt DateTime // KST 주입

  post     CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   CommunityComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children CommunityComment[] @relation("CommentThread")

  @@index([postId, createdAt])
}
