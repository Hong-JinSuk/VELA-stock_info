// overview 페이지에 표시할 데이터 타입
enum SnapshotType {
  AI_INSIGHT      // Gemini AI 섹터 인사이트
  MARKET_SUMMARY  // 향후 확장용
}

// 타입별 일일 스냅샷 (AI 인사이트 등 문서 단위 데이터)
// id: Edge Function/cron이 DB-side 자동 생성을 사용하므로 dbgenerated로 고정
model DailySnapshot {
  id        String       @id @default(dbgenerated("gen_random_uuid()::text"))
  type      SnapshotType
  dateKey   String       // "YYYY-MM-DD" KST 기준
  payload   Json
  createdAt DateTime     @default(now())

  @@unique([type, dateKey])
  @@index([type, dateKey])
}

// indicator의 "현재 상태" (id 1행). 카드 렌더링의 단일 소스.
// gemini-server batch가 (indicatorId)로 upsert. value/observationDate가 동일하면 update 자체 스킵.
model Indicator {
  id     String @id // catalog 내부 ID (예: "vix", "ust_10y")
  source String // "fred" | "yahoo" (디버깅용)
  // catalog 발표 주기: 'realtime' | 'daily' | 'weekly' | 'monthly' | 'quarterly'.
  // History 누적 여부 결정 + UI 필터(매일/실시간/분기 등)에 사용.
  frequency String

  value             Float
  previousValue     Float?
  // 전전 발표 데이터 (scheduled 지표 발표일 당일에 3개 값 표시용).
  // upsertSnapshots에서 value 변경 시 기존 previousValue가 여기로 shift됨.
  prevPreviousValue Float?
  change            Float? // 절대값 차이 (value - previousValue)
  changePercent     Float? // 비율 차이 (%)
  observationDate   String? // 소스측 관측일 "YYYY-MM-DD" (예: FRED CPI 발표월)
  nextReleaseDate   String? // 다음 발표 예정일 ("YYYY-MM-DD"). monthly/weekly/quarterly만 채워짐.
  // 마지막 release(value 변경) 시각. scheduled 지표만 갱신. 프론트에서 "오늘 발표" 감지에 사용.
  releasedAt        DateTime? @db.Timestamptz(3)

  category    String? // 'inflation' | 'employment' | 'growth' | 'monetary' | 'housing' | 'consumer' | 'business_cycle' | 'market' | 'other'
  displayMeta Json? // 카드 UI 표시용 메타데이터 (catalog의 indicator.display)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  history      IndicatorHistory[]
  keyIndicator KeyIndicator?
}

// 경제지표 페이지 상단에 고정 노출하는 "중요 지표" — ADMIN이 손으로 큐레이션(유저별 아님).
// indicatorId = Indicator.id. 카테고리 섹션과 별개로 맨 위에 모아 보여주는 용도.
model KeyIndicator {
  indicatorId String   @id // Indicator.id (예: "ust_10y")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

// daily/realtime 지표의 7일치 시계열 (sparkline/차트용).
// monthly/weekly/quarterly는 행 없음 (Indicator.previousValue로 충분).
// (indicatorId, dateKey) unique → realtime 15분 폴링해도 하루 1행만 유지.
// cleanup cron이 createdAt 기준 7일 초과 행 제거.
model IndicatorHistory {
  id              String   @id @default(uuid())
  indicatorId     String
  dateKey         String   // "YYYY-MM-DD" KST 기준
  value           Float
  observationDate String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, dateKey])
  @@index([indicatorId, createdAt])
}

// 배치 잡 실행 로그. gemini-server의 Edge(cron + 프로덕션 수동) / Express(로컬 수동)가 raw SQL로 1행 기록.
// job: "thirteenf-summary" | "fred-daily" | "overview-snapshot" | "update-13f-filers"
// trigger: "CRON" | "MANUAL", status: "SUCCESS" | "ERROR"
model BatchLog {
  id         String   @id @default(uuid())
  job        String
  trigger    String
  status     String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  result     Json? // 잡별 결과 (processed/failed/count 등)
  message    String? // 에러 메시지 (status=ERROR)
  createdAt  DateTime @default(now())

  items BatchLogItem[]

  @@index([job, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// 배치 항목별 상세 로그. env BATCH_LOG_DETAIL=true일 때만 적재 (예: 지표별/filer별 1행).
model BatchLogItem {
  id         String   @id @default(uuid())
  batchLogId String
  key        String // 항목 식별자 (indicatorId, filer cik 등)
  label      String? // 사람이 읽을 라벨 (지표명, filer명 등)
  status     String // "SUCCESS" | "ERROR"
  data       Json? // 항목별 값/결과
  createdAt  DateTime @default(now())

  batchLog BatchLog @relation(fields: [batchLogId], references: [id], onDelete: Cascade)

  @@index([batchLogId])
}

model AiLog {
  id     String @id @default(uuid())
  userId String

  actionType String // 예: "PREDICT", "COMPARE"
  ticker     String? // 종목 코드
  
  createdAt DateTime @default(now())

  queryData  Json? // AI 요청 데이터 (stockData 등)
  refineData Json? // 프롬프트화된 요청 데이터
  resultData Json? // AI 응답 데이터

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 유저의 날짜별 쿼리를 빠르게 하기 위한 인덱스
  @@index([userId, createdAt])
}
