// overview 페이지에 표시할 데이터 타입
enum SnapshotType {
  AI_INSIGHT      // Gemini AI 섹터 인사이트
  MARKET_SUMMARY  // 향후 확장용
}

// 타입별 일일 스냅샷 (AI 인사이트 등 문서 단위 데이터)
// id: Edge Function/cron이 DB-side 자동 생성을 사용하므로 dbgenerated로 고정
model DailySnapshot {
  id        String       @id @default(dbgenerated("gen_random_uuid()::text"))
  type      SnapshotType
  dateKey   String       // "YYYY-MM-DD" KST 기준
  payload   Json
  createdAt DateTime     @default(now())

  @@unique([type, dateKey])
  @@index([type, dateKey])
}

// 개별 매크로 지표 스냅샷 (지표 id별 개별 레코드 → 사용자 맞춤화 대비)
model MacroIndicatorSnapshot {
  id          String   @id @default(uuid())
  indicatorId String   // 'vix', 'treasury-10y' 등
  dateKey     String   // "YYYY-MM-DD" KST 기준
  valueMain   String
  valueSuffix String
  status      String   // 'Good' | 'Neutral' | 'Bad'
  createdAt   DateTime @default(now())

  @@unique([indicatorId, dateKey])
  @@index([indicatorId, dateKey])
}

model AiLog {
  id     String @id @default(uuid())
  userId String

  actionType String // 예: "PREDICT", "COMPARE"
  ticker     String? // 종목 코드
  
  createdAt DateTime @default(now())

  queryData  Json? // AI 요청 데이터 (stockData 등)
  refineData Json? // 프롬프트화된 요청 데이터
  resultData Json? // AI 응답 데이터

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 유저의 날짜별 쿼리를 빠르게 하기 위한 인덱스
  @@index([userId, createdAt])
}
