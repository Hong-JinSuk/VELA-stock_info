enum Role {
  FREE
  BASIC
  PRO
  MAX
  ADMIN
  TESTER
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String? // 실명 (네이버 회원이름 등)
  nickname String? @unique
  image    String? // 소셜 로그인 시 받아올 프로필 이미지
  password String? // 로컬 로그인을 위한 비밀번호 (소셜은 null)

  // 네이버 등 소셜에서 받아오는 부가 정보
  gender   String? // "M" / "F" / "U"
  birthday String? // "MM-DD"
  ageRange String? // "20-29" 등

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      Role @default(FREE)
  usage     UserUsage?

  emailVerified DateTime?
  accounts      Account[] // 유저가 가진 소셜 로그인 계정들 (1:N)
  sessions      Session[] // ??

  // 유저가 ai로 검색한 로그
  aiLog     AiLog[]

  // 개인화 즐겨찾기(종목·13F 등). 유료 전용 게이팅은 앱 레벨.
  favorites Favorite[]

  // 인앱 알림
  notifications Notification[]

  // 커뮤니티(사용 후기) 글/댓글
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
}

// 💡 소셜 로그인(OAuth) 정보를 저장하는 전용 테이블
model Account {
  id                String @id @default(uuid())
  userId            String
  type              String // "OAuth" 등
  provider          String // "google", "kakao", "github" 등
  providerAccountId String // OAuth가 부여한 해당 유저의 고유 ID

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 하나의 소셜 계정은 한 번만 연결되도록 복합키 설정
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserUsage {
  id          String   @id @default(uuid())
  userId      String   @unique
  
  // 💡 수정: 자식(UserUsage) 쪽에서는 onDelete: Cascade를 지웁니다.
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  maxLimit    Int
  usedCount   Int      @default(0)
  cycleStart  DateTime
  cycleEnd    DateTime
  updatedAt   DateTime @updatedAt
}
