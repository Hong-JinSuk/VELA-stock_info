// SEC 13F-HR 매니저 명단. gemini-server cron이 매일 form.idx에서 받아와 갱신.
// 자동완성 dropdown 용도. 분기 4번 윈도우에서 dedupe해 9k rows 내외.
model ThirteenFFiler {
  cik             String   @id @db.VarChar(10)
  name            String
  // 한국어 매니저명 (옵션). 수동 SQL UPDATE로 채움. cron UPSERT는 이 컬럼을 건드리지 X.
  krName          String?
  // 한국어 별칭/CEO명 (옵션). 예: "워렌 버핏" → Berkshire 매칭. 수동 SQL UPDATE로 채움.
  krNickname      String?
  lastFiledDate   String   @db.VarChar(10) // "YYYY-MM-DD"
  latestAccession String?  @db.VarChar(20) // "0001193125-26-217663". batch 직후엔 채워져 있어야 함
  updatedAt       DateTime @default(now())

  summaries ThirteenFSummary[]

  @@index([name])
  @@index([krName])
  @@index([krNickname])
  @@index([lastFiledDate])
}

// 펀드 × 현재 분기 풀요약. filer당 1행(분기마다 upsert) → 13F 리스트 한 행을 그린다.
// detail(개별 보유종목)은 저장하지 않고 이 요약만 박제. gemini-server 배치가 raw SQL로 write.
model ThirteenFSummary {
  id           String   @id @default(uuid()) @db.Uuid
  cik          String   @db.VarChar(10)
  accession    String   @db.VarChar(20)
  periodEnding String   @db.VarChar(10) // 분기말 "YYYY-MM-DD"
  fileDate     String   @db.VarChar(10) // REPORTED
  aumUsd       BigInt // 표지 tableValueTotal (단위 보정 적용)
  qoqPercent   Float? // 직전 분기 AUM 대비 %. 직전 없으면 null
  holdingCount Int
  topSectors   Json // [{ sector, weightPercent }]
  topHoldings  Json // [{ ticker, name, weightPercent }]
  topBuys      Json // [{ ticker, name, tradeUsd }] (주식수 델타 기준)
  topSells     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  filer ThirteenFFiler @relation(fields: [cik], references: [cik], onDelete: Cascade)

  @@unique([cik, periodEnding])
  @@index([fileDate(sort: Desc)])
}

// sparkline(TREND)용 얇은 AUM 시계열. 과거 분기는 표지(primary_doc.xml)만으로 백필.
model ThirteenFAumPoint {
  cik          String @db.VarChar(10)
  periodEnding String @db.VarChar(10)
  aumUsd       BigInt
  holdingCount Int

  @@id([cik, periodEnding])
  @@index([cik, periodEnding(sort: Desc)])
}

// ticker → 섹터 캐시. Finnhub raw 라벨(finnhubIndustry)을 저장, GICS 버킷화는 코드(sector-bucket).
// finnhubIndustry=null은 "조회했으나 섹터 없음"(ETF/지수 등) → 재조회 방지용으로도 행 유지.
model TickerSector {
  ticker          String   @id
  finnhubIndustry String?
  updatedAt       DateTime @updatedAt
}

// CUSIP/CINS → ticker·name 영구 캐시. OpenFIGI 매핑 결과를 박제해 배치마다 재호출 방지.
// 거의 불변(상장폐지/티커변경 시에만 갱신). ticker=null은 "OpenFIGI에 US 라인 없음"(조회 완료)
// → 재조회 방지용으로도 행 유지. gemini-server 배치가 raw SQL로 read/upsert.
model CusipTicker {
  cusip     String   @id @db.VarChar(9)
  ticker    String?
  name      String?
  updatedAt DateTime @updatedAt
}

// 미국 전체 상장 심볼 디렉터리. gemini-server cron이 Finnhub /stock/symbol?exchange=US에서
// 받아 주 1회 갱신(1콜에 미국 전체). 종목 검색 자동완성 전용 — 검색이 이 테이블만 조회해
// Finnhub /search 콜을 안 먹는다(미스 시에만 fallback). equity류(Common Stock/ETP/ADR/REIT)만 적재, ~27k rows.
model StockSymbol {
  symbol        String   @id // "AAPL", "BRK.B"
  displaySymbol String?
  description   String // 영문 회사명 (Finnhub 원본, 대문자)
  type          String // "Common Stock" | "ETP" | "ADR" | "REIT"
  currency      String?
  mic           String? // 거래소 MIC (예: "XNAS", "XNYS")
  updatedAt     DateTime @default(now())

  etf StockSymbolEtf? // type='ETP'면 ETF 보유종목 상세(1:1). 아니면 null.
  valuation StockValuation? // 즐겨찾기 종목 적정주가 스냅샷(1:1). 종목 보고서용.

  @@index([description])
}

// ETF 보유종목 상세. StockSymbol(type='ETP')과 symbol로 1:1 관계 → 이름/타입/거래소는
// StockSymbol에서 join으로 가져오고(중복 저장 X), 여기엔 ETF 고유 정보만 둔다.
// gemini-server 배치가 Yahoo topHoldings에서 ETF별 top-10을 받아 저장.
// 점진 배치: cron tick마다 lastSyncedAt이 가장 오래된 N개만 순차 갱신 → Edge 타임아웃 회피.
// vela ETF 상세가 이 테이블만 조회(Yahoo live 호출 X).
model StockSymbolEtf {
  symbol       String   @id // = StockSymbol.symbol
  stockPct     Float? // 자산배분: 주식 비중 (0~1)
  bondPct      Float? // 채권 비중
  cashPct      Float? // 현금 비중
  // 직전 스냅샷 대비 top-10 변동. entered=신규 편입 심볼, exited=편출 심볼.
  entered      String[] @default([])
  exited       String[] @default([])
  lastSyncedAt DateTime @default(now()) // 점진 배치 선택 기준(오래된 것부터)
  updatedAt    DateTime @updatedAt

  stock    StockSymbol             @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  holdings StockSymbolEtfHolding[]
}

// ETF top-10 개별 보유종목(현재 스냅샷). 갱신 시 해당 ETF 행을 전부 교체.
model StockSymbolEtfHolding {
  id        String  @id @default(uuid()) @db.Uuid
  etfSymbol String
  rank      Int // 1~10 (비중 내림차순)
  prevRank  Int? // 직전 스냅샷에서의 순위. 순위변동(▲▼) 계산용. null = 신규 진입 또는 최초 적재
  symbol    String? // 구성종목 티커. StockSymbol에 있으면 soft join 가능(현금/선물 등은 null)
  name      String // 구성종목명 (Yahoo 원본 — 비미국/현금은 StockSymbol에 없을 수 있어 직접 저장)
  weight    Float // 비중 (0~1)

  etf StockSymbolEtf @relation(fields: [etfSymbol], references: [symbol], onDelete: Cascade)

  @@unique([etfSymbol, rank])
  @@index([etfSymbol])
  @@index([symbol])
}

// 종목 적정주가 스냅샷 (종목 보고서). 심볼당 1행 — 전체 유저 즐겨찾기의 dedup 집합을
// gemini-server 배치가 신선도 회전(가장 오래된 것부터 N개)으로 갱신 → vela는 DB만 읽음.
// Finnhub metric=all(forward P/E·ROA·EPS성장률) + /quote(현재가)로 PEG 기반 적정주가 계산.
// 폴리모픽 Favorite(type='STOCK')의 itemKey = symbol. 입력값도 함께 저장(표시/재현용).
model StockValuation {
  symbol       String   @id // = StockSymbol.symbol
  price        Float // 스냅샷 시점 현재가 (Finnhub /quote .c)
  forwardPe    Float? // forward P/E
  growthPct    Float? // 적정PER 계산에 실제 쓴 EPS 성장률(%)
  growthOverride Float? // 수동 조정 성장률(%) — 시트 '평균성장률 조정'. 있으면 자동성장률 대신 이 값 사용. 배치가 덮어쓰지 X(admin이 입력)
  growthSource String // 'EPS_5Y' | 'EPS_3Y' | 'EPS_TTM' | 'MANUAL'
  roaTtm       Float? // ROA(TTM) — 수익성 품질 배지용
  high52w      Float? // 52주 최고가 (참고)
  targetPeg    Float // 목표 PEG (현재 1.0). 모델 변경 추적용
  fairPe       Float? // 적정 PER
  fairValue    Float? // 적정주가
  upsidePct    Float? // 상승여력(%)
  prevUpsidePct Float? // 직전 스냅샷 upsidePct — −→+ 전환 감지용(단일행 덮어쓰기라 비교값 보존)
  status       String // 'OK' | 'NO_EARNINGS'
  snapshotAt   DateTime // KST 벽시계 (배치 시점). 신선도 회전 정렬 기준
  updatedAt    DateTime @updatedAt

  stock StockSymbol @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([snapshotAt]) // 가장 오래된 것부터 갱신
}
